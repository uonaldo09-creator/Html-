# ─── Required ────────────────────────────────────────────────────────────────
# Server will refuse to start if any of these are missing/empty.
PORT=3000
LOG_LEVEL=info
DATABASE_URL=

# ─── AI (Groq) ───────────────────────────────────────────────────────────────
GROQ_API_KEY=

# ─── Email delivery (Resend) ─────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=UniInfo <no-reply@yourdomain.com>

# ─── Backups ─────────────────────────────────────────────────────────────────
# 32+ char passphrase used to AES-encrypt database backups at rest.
BACKUP_ENCRYPTION_KEY=

# ─── Firebase (optional) ─────────────────────────────────────────────────────
# Client-side config for Google sign-in. Values come from the Firebase console
# (Project settings → Your apps → Web app). These are NOT secrets, but keep
# them in the environment so a project can be rotated without a code change.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-side Firebase Admin project id (used to verify Google ID tokens).
FIREBASE_PROJECT_ID=
# Set true only for a local server with NODE_ENV=development.
ENABLE_DEV_AUTH_BYPASS=false

# Never enable the data migration until the identity mapping and restore rehearsal pass.
CONVEX_MIGRATION_ENABLED=false

# ─── Optional: isolated UniInfo Convex catalog reads ─────────────────────────
# Leave empty to keep the current PostgreSQL-backed catalog.
UNIINFO_CATALOG_BACKEND=
UNIINFO_CONVEX_DEPLOYMENT=
UNIINFO_CONVEX_URL=

# ─── Optional: Express-issued Convex JWT bridge ──────────────────────────────
# The HTTPS issuer must serve /.well-known/jwks.json and match Convex auth.config.
CONVEX_AUTH_ISSUER=
CONVEX_AUTH_AUDIENCE=
# CONVEX_AUTH_PRIVATE_KEY must come from the server secret store; never commit it.
# Configure it only on the backend; never use a VITE_ prefix for this private key.
CONVEX_AUTH_PRIVATE_KEY=

# ─── Optional: cross-origin deployments ─────────────────────────────────────
# Comma-separated extra origins allowed to call this API with credentials.
# Same-origin requests always work; leave empty unless the SPA is served from a
# different host than the API.
ALLOWED_ORIGINS=

# ─── Optional: S3 backups ────────────────────────────────────────────────────
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── Optional: Redis / BullMQ ────────────────────────────────────────────────
REDIS_URL=

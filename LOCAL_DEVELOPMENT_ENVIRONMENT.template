# Copy this file to .env for the Express server. Do not replace .env.local or
# .env.uniinfo-convex.local. Fill only values obtained from the listed provider.
# Never put CONVEX_DEPLOY_KEY or other server secrets in VITE_* variables.

# Required by server.ts at startup. A local PostgreSQL database is safe here.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
DATABASE_URL=postgresql://postgres:your_local_password_here@127.0.0.1:5432/uniinfo_dev

# Optional application origin for verification links. Leave blank to use the
# request origin in local development.
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=

# Optional: AI counselor. Obtain from the Groq project used for UniInfo.
GROQ_API_KEY=
GROQ_REQUEST_TIMEOUT_MS=15000

# Optional: verification email. Obtain from the UniInfo Resend account/domain.
RESEND_API_KEY=
EMAIL_FROM=

# Optional except when creating or restoring encrypted backups. Create and
# retain a 32-byte/64-hex-character key in a password manager or secret store.
BACKUP_ENCRYPTION_KEY=
BACKUP_DIR=

# Optional: Google sign-in. These VITE_* settings are public Firebase web-app
# identifiers. They are not server credentials. FIREBASE_PROJECT_ID is used by
# firebase-admin to verify Google ID tokens.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=

# Optional local-only bypass. Keep false unless explicitly testing the guarded
# development-auth flow; never enable it outside a local machine.
ENABLE_DEV_AUTH_BYPASS=false

# Optional: Redis. With no URL, the application uses local in-memory caching
# and rate limiting.
REDIS_URL=

# Optional: S3-compatible backup storage. All four values are required before
# remote backup storage is used. S3_ENDPOINT is needed for MinIO/Supabase-like
# endpoints; leave blank for AWS S3.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional guarded Convex catalog reads. Leave blank/off for the current
# PostgreSQL-backed runtime. If deliberately enabled, use only the dedicated
# UniInfo development deployment values supplied separately by the project
# owner. The application rejects any other deployment/host combination.
UNIINFO_CATALOG_BACKEND=
UNIINFO_CONVEX_DEPLOYMENT=
UNIINFO_CONVEX_URL=

# Do not add CONVEX_DEPLOY_KEY here. It remains only in
# .env.uniinfo-convex.local for migration tooling.
